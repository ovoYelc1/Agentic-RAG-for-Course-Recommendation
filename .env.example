# AI 服务配置
# 复制此文件为 .env 并填入实际值

# OpenAI API (或兼容 API，如通义千问、智谱等)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 可选网页搜索。全部留空时按已配置的 Key 选择供应商，否则回退到 DuckDuckGo。
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPAPI_KEY=
SERPER_API_KEY=

# 如果使用通义千问，改为:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# Chroma 向量库（AI 服务不再直连业务 MySQL）
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=1
REDIS_INTENT_DB=2
BACKEND_REDIS_DB=0

# 检索开关：生产主链路为 Vector Top40 + BM25 Top20 + RRF [1.0, 0.3]
RAG_HYBRID=1
RAG_FUSION=v3
RAG_FUSION_ALPHA=0
RAG_LEVEL_AWARE=0
RAG_QU=0
RAG_QREWRITE=0
RAG_IDF_OOV=0
RAG_SCORE_DUMP=0

# 消息队列与课程索引重建
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=YOUR_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD
COURSE_MQ_QUEUE=queue.course.ai
BACKEND_BASE_URL=http://localhost:8080
INTERNAL_API_TOKEN=YOUR_INTERNAL_API_TOKEN

# MySQL 语料构建
# 以下配置供 scripts/build_corpus.py 使用；脚本不会自动加载 .env，
# 运行时必须由 PowerShell、Shell 或 CI 环境显式提供 MYSQL_* 环境变量。
# 请使用仅具备所需读取权限的专用低权限数据库账号。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=YOUR_MYSQL_READONLY_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=itcloudclassroom

# 鉴权与限流
# false 仅用于本地开发和受控的直连调试。
# 公开生产部署必须明确设置 AI_REQUIRE_AUTH=true。
# AI_SERVICE_TOKEN 必须与后端网关传递的服务令牌一致。
# JWT_SECRET 必须与后端使用相同的 Base64 密钥。
# INTERNAL_API_TOKEN 是独立的内部接口令牌，不得与 AI_SERVICE_TOKEN 混用。
# Redis 黑名单配置（REDIS_HOST/PORT/PASSWORD/BACKEND_REDIS_DB）必须与实际部署一致。
AI_REQUIRE_AUTH=false
AI_SERVICE_TOKEN=YOUR_AI_SERVICE_TOKEN
JWT_SECRET=YOUR_JWT_SECRET
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_CONCURRENCY_PER_USER=1
AI_TOOL_LOOP_BUDGET=90
AI_TOOL_TIMEOUT=40
CORS_ORIGINS=http://localhost:5173

# AI 服务端口
AI_SERVICE_PORT=8000
